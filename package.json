{
  "name": "the-byte-array",
  "type": "module",
  "version": "5.0.0",
  "private": true,
  "description": "The Byte Array website: privacy-first apps and developer tools.",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "tokens": "node scripts/generate-tokens.mjs",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens && npm run downloads:verify && npm run audio:verify",
    "downloads:verify": "node scripts/verify-downloads.mjs",
    "check": "astro check",
    "assets": "node scripts/generate-assets.mjs",
    "icons": "node scripts/fetch-icons.mjs",
    "audio": "node scripts/generate-audio.mjs",
    "audio:verify": "node scripts/generate-audio.mjs --check",
    "deploy": "bash deploy/deploy.sh"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@material/material-color-utilities": "^0.3.0",
    "github-slugger": "^2.0.0",
    "kokoro-js": "^1.2.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "pagefind": "^1.5.2",
    "satori": "^0.47.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.34.0",
    "typescript": "^6.0.3"
  }
}
