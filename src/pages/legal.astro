---
import PageHeader from '../components/PageHeader.astro';
import { apps } from '../data/apps';
import Base from '../layouts/Base.astro';

const siteWide = [
  { label: 'Site privacy', href: '/privacy/' },
  { label: 'Terms', href: '/terms/' },
  { label: 'Refund policy', href: '/refund-policy/' },
];

// Live apps first, then the ones we no longer maintain.
const byApp = [...apps]
  .sort((a, b) => Number(!!a.discontinued) - Number(!!b.discontinued))
  .map((app) => ({
    app,
    links: [
      ...(app.privacyPath ? [{ label: 'Privacy policy', href: app.privacyPath }] : []),
      ...(app.termsPath ? [{ label: 'Terms of service', href: app.termsPath }] : []),
    ],
  }))
  .filter(({ links }) => links.length > 0);

const linkClass =
  'flex min-h-12 items-center justify-between gap-3 rounded-lg px-4 text-body-lg transition-expressive hover:bg-secondary-container hover:text-on-secondary-container';
---

<Base
  title="Legal"
  description="Privacy policies, terms of service and the refund policy for The Byte Array's website and each of our apps."
  breadcrumbs={[{ name: 'Legal', path: '/legal/' }]}
>
  <div data-pagefind-body>
    <PageHeader
      title="Legal"
      lede="Our privacy policies, terms and refund policy. Each app has its own privacy policy."
    />

    <div class="grid gap-10 md:grid-cols-2 md:gap-12">
      <section aria-labelledby="site-wide">
        <h2 id="site-wide" class="font-display text-headline-sm">This website and purchases</h2>
        <ul class="mt-4 rounded-xl bg-surface-container p-2">
          {
            siteWide.map(({ label, href }) => (
              <li>
                <a href={href} class={linkClass}>{label}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="by-app">
        <h2 id="by-app" class="font-display text-headline-sm">By app</h2>
        <div class="mt-4 flex flex-col gap-4">
          {
            byApp.map(({ app, links }) => (
              <div class="rounded-xl bg-surface-container p-2">
                <h3 class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 pt-3 pb-1 font-display text-title-lg">
                  {app.name}
                  {app.discontinued && (
                    <span class="chip chip-sm chip-tonal text-on-surface-variant">No longer maintained</span>
                  )}
                </h3>
                <ul>
                  {links.map(({ label, href }) => (
                    <li>
                      <a href={href} class={linkClass}>{label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Base>
