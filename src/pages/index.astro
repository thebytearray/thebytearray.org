---
import { Image } from 'astro:assets';
import Chip from '../components/Chip.astro';
import ColorPicker from '../components/ColorPicker.astro';
import Shape from '../components/Shape.astro';
import Icon from '../components/Icon.astro';
import { apps } from '../data/apps';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts } from '../lib/posts';

const latestPosts = (await getPosts()).slice(0, 3);
---

<Base
  description="The Byte Array makes offline Android apps and open-source developer tools: Convertit audio-video converter, utilities, no ads, no tracking, no accounts."
>
  <!-- Hero: one job (trust + explore), one primary CTA. ColorPicker stays but demoted. -->
  <section class="relative isolate pt-8 pb-14 sm:pt-14 sm:pb-20">
    <div
      class="pointer-events-none absolute top-2 right-[-24%] -z-10 aspect-square w-[min(17rem,66vw)] sm:right-[-10%] sm:w-80 lg:top-0 lg:right-[-2%] lg:w-[31rem]"
    >
      <Shape lobes={9} depth={0.07} class="absolute inset-0 animate-drift text-primary-container" />
    </div>

    <h1 class="font-display text-[clamp(2.75rem,10.5vw,7rem)] leading-[0.9] font-extrabold tracking-[-0.045em]">
      No BS.<br /><span class="text-primary">Straight to the point.</span>
    </h1>

    <p class="mt-7 max-w-md font-display text-title-lg text-pretty sm:mt-10 sm:max-w-2xl sm:text-headline-sm">
      The Byte Array makes mobile apps, libraries and developer tools that do one job well. Our apps have no ads, no
      tracking and no accounts.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-2 sm:mt-10 sm:gap-2.5">
      <Chip href="/apps/" variant="filled">See our apps</Chip>
      <Chip href="/open-source/" icon="code">Browse open source</Chip>
    </div>

    <div class="mt-6 flex items-center gap-3 opacity-80 sm:mt-7">
      <span class="text-label-md text-on-surface-variant">Accent:</span>
      <ColorPicker class="-ml-2 [&_button]:size-8 [&_span]:size-6" />
    </div>
  </section>

  <!-- Proof: compact app list. No screenshots, no Play buttons here — details live on /apps/. -->
  <section aria-labelledby="apps" class="mt-4 sm:mt-6">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <h2 id="apps" class="font-display text-headline-lg sm:text-display-sm">Apps</h2>
        <p class="mt-1 text-body-lg text-on-surface-variant">Three apps. Each does one job well.</p>
      </div>
      <a
        href="/apps/"
        class="inline-flex min-h-10 items-center gap-1 rounded-full px-3 text-label-lg text-primary transition-expressive hover:bg-primary-container hover:text-on-primary-container"
      >
        All apps
        <Icon name="arrow_forward" class="text-[1.125rem]" />
      </a>
    </div>
    <ul class="mt-6 divide-y divide-outline-variant border-y border-outline-variant sm:mt-8">
      {
        apps.map((app) => (
          <li>
            <a
              href={`/apps/${app.slug}/`}
              class="group flex items-center gap-4 py-4 sm:gap-5 sm:py-5"
            >
              <Image
                src={app.icon}
                alt=""
                width={128}
                height={128}
                loading="lazy"
                class="size-12 flex-none rounded-[22%] sm:size-14"
              />
              <span class="min-w-0 flex-1">
                <span class="block font-display text-title-lg leading-tight group-hover:text-primary group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
                  {app.name}
                </span>
                <span class="mt-0.5 block truncate text-body-md text-on-surface-variant sm:whitespace-normal">
                  {app.summary}
                </span>
              </span>
              <Icon
                name="arrow_forward"
                class="flex-none text-on-surface-variant transition-expressive group-hover:translate-x-1 group-hover:text-primary"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Blog: latest posts. -->
  <section aria-labelledby="blog" class="mt-14 sm:mt-20">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <h2 id="blog" class="font-display text-headline-lg sm:text-display-sm">Blog</h2>
        <p class="mt-1 text-body-lg text-on-surface-variant">Product updates and notes from The Byte Array.</p>
      </div>
      <a
        href="/blog/"
        class="inline-flex min-h-10 items-center gap-1 rounded-full px-3 text-label-lg text-primary transition-expressive hover:bg-primary-container hover:text-on-primary-container"
      >
        All posts
        <Icon name="arrow_forward" class="text-[1.125rem]" />
      </a>
    </div>
    {
      latestPosts.length > 0 && (
        <ul class="mt-6 divide-y divide-outline-variant border-y border-outline-variant sm:mt-8">
          {latestPosts.map((post) => (
            <li class="py-1">
              <PostRow post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- Trust: one line, links out. Full story lives on /about/. -->
  <section aria-label="Our promise" class="mt-14 sm:mt-20">
    <p class="max-w-2xl text-body-lg text-pretty text-on-surface-variant">
      Everything we ship is <strong class="font-semibold text-on-surface">private by default</strong> and much of it
      is open source. <a href="/about/" class="rounded-sm text-primary underline decoration-1 underline-offset-4 hover:decoration-2">How we work</a>
    </p>
  </section>

  <!-- Contact: demoted from second hero to quiet closer. Single CTA. -->
  <section
    aria-labelledby="contact-title"
    id="contact"
    class="mt-14 scroll-mt-24 rounded-xl-inc bg-surface-container p-6 sm:mt-20 sm:rounded-2xl sm:p-10 lg:p-12"
  >
    <h2 id="contact-title" class="font-display text-headline-md sm:text-headline-lg">
      Questions or ideas?
    </h2>
    <p class="mt-2 max-w-xl text-body-lg text-pretty text-on-surface-variant">
      Get help with one of our apps, suggest a feature, or talk to us about working together.
    </p>
    <p class="mt-6">
      <Chip href="/contact/" icon="send" variant="filled">Contact us</Chip>
    </p>
  </section>
</Base>
