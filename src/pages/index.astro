---
import AppCard from '../components/AppCard.astro';
import Chip from '../components/Chip.astro';
import ColorPicker from '../components/ColorPicker.astro';
import PostRow from '../components/PostRow.astro';
import RepoList from '../components/RepoList.astro';
import Shape from '../components/Shape.astro';
import FeaturedApp from '../components/FeaturedApp.astro';
import { featuredApp, otherApps } from '../data/apps';
import { site, socials } from '../data/site';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);

const sectionLink =
  '-mr-3 inline-flex min-h-10 items-center rounded-full px-3 text-label-lg whitespace-nowrap text-primary transition-expressive hover:bg-primary-container hover:text-on-primary-container lg:mr-0 lg:-ml-3';
---

<Base>
  <section class="relative isolate pt-8 pb-16 sm:pt-14 sm:pb-24 lg:pb-28">
    <div
      class="pointer-events-none absolute top-2 right-[-24%] -z-10 aspect-square w-[min(17rem,66vw)] sm:right-[-10%] sm:w-80 lg:top-0 lg:right-[-2%] lg:w-[31rem]"
    >
      <Shape lobes={9} depth={0.07} class="absolute inset-0 animate-drift text-primary-container" />
    </div>

    <h1 class="font-display text-[clamp(2.75rem,10.5vw,7rem)] leading-[0.9] font-extrabold tracking-[-0.045em]">
      No BS.<br /><span class="text-primary">Straight to the point.</span>
    </h1>

    <p class="mt-7 max-w-md font-display text-title-lg text-pretty sm:mt-10 sm:max-w-2xl sm:text-headline-sm">
      {site.name} makes mobile apps, libraries and developer tools that do one job well. Our apps have no ads, no
      tracking and no accounts.
    </p>

    <ul class="mt-8 flex flex-wrap gap-2 sm:mt-10 sm:gap-2.5">
      <li><Chip href="/apps/" variant="filled">See our apps</Chip></li>
      <li><Chip href="/open-source/" icon="code" class="bg-surface">Browse open source</Chip></li>
    </ul>

    <ColorPicker class="mt-5 -ml-2 sm:mt-6" />
  </section>

  <section aria-labelledby="apps">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <h2 id="apps" class="font-display text-headline-lg sm:text-display-sm">Apps</h2>
        <p class="mt-1 text-body-lg text-on-surface-variant">Available on Google Play.</p>
      </div>
    </div>
    {featuredApp && <FeaturedApp app={featuredApp} class="mt-6 sm:mt-8" />}
    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 md:grid-cols-2">
      {
        otherApps.map((app, i) => (
          <AppCard
            app={app}
            tone={i % 2 === 0 ? 'primary' : 'tertiary'}
            class:list={[
              'rounded-xl-inc sm:rounded-2xl',
              i === otherApps.length - 1 && 'rounded-br-md sm:rounded-br-md',
            ]}
          />
        ))
      }
    </div>
  </section>

  <section aria-labelledby="open-source" class="mt-20 grid gap-x-10 gap-y-4 sm:mt-28 lg:grid-cols-[11rem_1fr]">
    <div class="flex items-center justify-between gap-4 lg:flex-col lg:items-start lg:justify-start lg:gap-1">
      <div>
        <h2 id="open-source" class="font-display text-headline-md">Open source</h2>
        <p class="mt-2 text-body-md text-on-surface-variant max-lg:hidden">
          Libraries, tools and apps we publish on GitHub.
        </p>
      </div>
      <a href="/open-source/" class={sectionLink}>All repositories</a>
    </div>
    <RepoList limit={4} />
  </section>

  {
    posts.length > 0 && (
      <section aria-labelledby="writing" class="mt-14 grid gap-x-10 gap-y-3 sm:mt-20 lg:grid-cols-[11rem_1fr]">
        <div class="flex items-center justify-between gap-4 lg:flex-col lg:items-start lg:justify-start lg:gap-1">
          <h2 id="writing" class="font-display text-headline-md">From the blog</h2>
          <a href="/blog/" class={sectionLink}>
            All posts
          </a>
        </div>
        <ul class="divide-y divide-outline-variant border-y border-outline-variant">
          {posts.map((post) => (
            <li class="py-1">
              <PostRow post={post} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section
    aria-labelledby="contact-title"
    id="contact"
    class="relative isolate mt-20 scroll-mt-24 overflow-clip rounded-xl-inc rounded-bl-md bg-primary-container p-6 text-on-primary-container sm:mt-28 sm:rounded-2xl sm:rounded-bl-md sm:p-10 lg:mt-32 lg:rounded-3xl lg:rounded-bl-lg lg:p-14"
  >
    <Shape
      kind="clover"
      class="absolute -right-16 -bottom-24 -z-10 w-64 animate-drift text-primary opacity-15 sm:w-80 lg:-right-10 lg:w-96"
    />
    <h2
      id="contact-title"
      class="font-display text-[clamp(2.25rem,8vw,4.5rem)] leading-[0.95] font-extrabold tracking-[-0.035em]"
    >
      Questions or ideas?
    </h2>
    <p class="mt-4 max-w-xl text-body-lg text-pretty opacity-85 sm:mt-5">
      Get help with one of our apps, suggest a feature, or talk to us about working together.
    </p>
    <ul class="mt-7 flex flex-wrap gap-2 sm:mt-9 sm:gap-2.5">
      <li><Chip href="/contact/" icon="send" variant="filled">Contact us</Chip></li>
      {
        socials
          .filter((s) => s.hero)
          .map((s) => (
            <li>
              <Chip
                href={s.mail ? undefined : s.href}
                button={Boolean(s.mail)}
                icon={s.brand ? undefined : s.icon}
                class="border-transparent bg-surface text-on-surface"
                data-mail={s.mail}
              >
                {s.brand && (
                  <svg viewBox="0 0 24 24" class="size-[1.125rem] flex-none" fill="currentColor" aria-hidden="true">
                    <path d={s.brand} />
                  </svg>
                )}
                <span class="sr-only">{s.label}: </span>
                {s.mail ? (
                  <span data-mail-label aria-live="polite">
                    {s.handle}
                  </span>
                ) : (
                  s.handle
                )}
              </Chip>
            </li>
          ))
      }
    </ul>
  </section>
</Base>
