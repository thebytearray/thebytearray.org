---
import { Image } from 'astro:assets';
import Chip from '../components/Chip.astro';
import Shape from '../components/Shape.astro';
import Icon from '../components/Icon.astro';
import FeatureList from '../components/FeatureList.astro';
import { apps, type AppFeature } from '../data/apps';
import { brands, site } from '../data/site';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, tagSlug } from '../lib/posts';
import { formatPrice, getPrices } from '../lib/prices';

const latestPosts = (await getPosts()).slice(0, 3);
// Only apps people can still install; free before paid, so the comparison
// reads from the free app to the upgrade.
const liveApps = apps.filter((app) => !app.discontinued).sort((a, b) => Number(!!a.paid) - Number(!!b.paid));
const convertit = apps.find((app) => app.slug === 'convertit')!;

const reasons: AppFeature[] = [
  {
    icon: 'wifi_off',
    title: 'Works without internet',
    description:
      'Every conversion runs on your phone. Neither app has permission to use the internet, so your files can’t be uploaded anywhere.',
  },
  {
    icon: 'lock',
    title: 'Nothing to sign up for',
    description: 'The apps have no ads, no tracking and no account. Open one and start converting.',
  },
  {
    icon: 'sell',
    title: 'Pay once for Pro',
    description: 'Convertit Pro is a single purchase on Google Play. There is no subscription to keep paying.',
  },
  {
    icon: 'movie',
    title: 'Keeps the quality you recorded',
    description:
      'Pro keeps HDR10+ data when it compresses video. It converts audio to lossless FLAC and can split one long file into tracks using its CUE sheet.',
  },
];

// What happens when something goes wrong, in the terms the contact page and
// refund policy use.
const support: AppFeature[] = [
  {
    icon: 'mail',
    title: 'A person reads every message',
    description: 'Email us or use the contact form. We aim to reply within 5 business days.',
  },
  {
    icon: 'info',
    title: 'Guides for every setting',
    description: 'Step-by-step guides explain each option in the Pro video compressor and audio converter.',
  },
  {
    icon: 'gavel',
    title: 'A fair refund policy',
    description:
      'If a feature we advertise does not work and we cannot fix it within 14 business days, you can ask for a refund.',
  },
  {
    icon: 'shield',
    title: 'Privacy policies you can read',
    description: 'Each app has a short privacy policy you can read in a few minutes.',
  },
];
---

<Base
  description="Convertit is a free offline audio and video converter for Android. Convertit Pro adds video compression with HDR10+, lossless audio and image tools for one payment."
>
  <!-- Hero: one job (trust + explore), one primary CTA. The shape sits in the
       open space beside the lede and holds the app icons, so it is proof
       rather than decoration. -->
  <section class="relative isolate pt-8 pb-10 sm:pt-14 sm:pb-14">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center lg:gap-16">
      <div>
        <h1 class="max-w-4xl font-display text-[clamp(2.5rem,8.5vw,5.75rem)] leading-[0.95] font-extrabold tracking-[-0.035em] text-balance">
          Convert and compress media, <span class="text-primary">offline</span>
        </h1>
        <p class="mt-7 max-w-xl sm:mt-10 font-display text-title-lg text-pretty sm:text-headline-sm">
          We make Convertit, a free audio and video converter for Android, and Convertit Pro, which adds video
          compression, lossless audio and image tools for one payment. Your files never leave your phone.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-2 sm:mt-10 sm:gap-2.5">
          <Chip href="#apps" variant="filled">Compare the apps</Chip>
          <Chip href={convertit.playStoreUrl}>
            <svg viewBox="0 0 24 24" class="size-4 flex-none" fill="currentColor" aria-hidden="true">
              <path d={brands.googlePlay}></path>
            </svg>
            Get Convertit on Google Play
          </Chip>
        </div>
      </div>

      <div aria-hidden="true" class="relative mx-auto aspect-square w-full max-w-[22rem] max-lg:hidden">
        <Shape lobes={9} depth={0.07} class="absolute inset-0 animate-drift text-primary-container" />
        <!-- Only apps you can still install: this is the "what we ship" proof. -->
        <div class="absolute inset-0 grid place-items-center">
          <div class="relative h-44 w-56">
            {
              apps
                .filter((app) => !app.discontinued)
                .slice(0, 2)
                .map((app, i) => (
                  <Image
                    src={app.icon}
                    alt=""
                    width={192}
                    height={192}
                    loading="lazy"
                    class:list={[
                      'absolute size-28 rounded-[22%] shadow-level3',
                      i === 0 ? 'top-0 left-0 -rotate-8' : 'right-0 bottom-0 rotate-6',
                    ]}
                  />
                ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The apps people can install today, side by side so the choice is quick.
       Past apps live on the Apps page. -->
  <section aria-labelledby="apps-title" id="apps" class="mt-4 scroll-mt-24 sm:mt-6">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <h2 id="apps-title" class="font-display text-headline-lg sm:text-display-sm">Which one do you need?</h2>
      <a
        href="/apps/"
        class="inline-flex min-h-10 items-center gap-1 rounded-full px-3 text-label-lg text-primary transition-expressive hover:bg-primary-container hover:text-on-primary-container"
      >
        All apps
        <Icon name="arrow_forward" class="text-[1.125rem]" />
      </a>
    </div>
    <ul class="mt-6 grid gap-3 sm:mt-8 sm:gap-4 md:grid-cols-2">
      {
        liveApps.map((app) => (
          <li class="flex flex-col rounded-xl bg-surface-container p-6 sm:p-8">
            <a href={`/apps/${app.slug}/`} class="group flex items-center gap-4">
              <Image
                src={app.icon}
                alt=""
                width={128}
                height={128}
                loading="lazy"
                class="size-14 flex-none rounded-[22%] sm:size-16"
              />
              <span class="min-w-0">
                <span class="block font-display text-headline-sm group-hover:text-primary group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
                  {app.name}
                </span>
                <span class="text-label-lg text-on-surface-variant">
                  {app.paid ? `One-time purchase: ${getPrices(app).map(formatPrice).join(' · ')}` : 'Free'}
                </span>
              </span>
            </a>
            {app.bestFor && <p class="mt-5 text-body-lg text-pretty">Pick it if {app.bestFor}</p>}
            {
              app.highlights && (
                <ul class="mt-4 flex-1 space-y-2">
                  {app.highlights.map((item) => (
                    <li class="flex gap-3 text-body-md text-on-surface-variant">
                      <Icon name="check" class="mt-0.5 flex-none text-[1.125rem] text-primary" />
                      {item}
                    </li>
                  ))}
                </ul>
              )
            }
            <p class="mt-6 flex flex-wrap gap-2">
              <Chip href={app.playStoreUrl} variant="filled" aria-label={`Get ${app.name} on Google Play`}>
                <svg viewBox="0 0 24 24" class="size-4 flex-none" fill="currentColor" aria-hidden="true">
                  <path d={brands.googlePlay}></path>
                </svg>
                Google Play
              </Chip>
              <Chip href={`/apps/${app.slug}/`} aria-label={`${app.name} details`}>Details</Chip>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Why the free app is free: people rightly ask what they pay with instead. -->
  <section aria-labelledby="why-free" class="mt-16 grid gap-x-10 gap-y-5 sm:mt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <h2 id="why-free" class="font-display text-headline-lg sm:text-display-sm">Why is Convertit free?</h2>
    <div class="max-w-2xl space-y-4 text-body-lg text-pretty">
      <p>
        There’s a saying: if a product is free, you’re the product. That isn’t the case here, and you should know
        exactly why the app is free.
      </p>
      <p>
        We want to make a real difference in how people convert audio on their phones, without nagging you or
        pushing you to pay. Free means free. We won’t lock the free features later to push you toward Pro.
      </p>
      <p>
        Convertit doesn’t have permission to use the internet, so it can’t send your files or your data anywhere.
        We don’t collect your data, and we never sell it.
      </p>
      <p>
        If you want to support our work and get the advanced tools, you can buy Convertit Pro. It’s a one-time
        purchase, and we won’t make promises about it that aren’t true.
      </p>
      <p>
        We try to answer quickly and fix problems fast, and we read every piece of feedback. It’s how we learn what
        to build next. <a href="/contact/" class="text-link">Send us your feedback</a>.
      </p>
    </div>
  </section>

  <!-- Why we work this way. -->
  <section aria-labelledby="why" class="mt-16 sm:mt-24">
    <h2 id="why" class="font-display text-headline-lg sm:text-display-sm">Why pick Convertit</h2>
    <p class="mt-2 max-w-2xl text-body-lg text-pretty text-on-surface-variant">
      Useful apps shouldn’t cost you your privacy.
    </p>
    <div class="mt-6 sm:mt-8">
      <FeatureList features={reasons} />
    </div>
    <p class="mt-5">
      <a href="/about/" class="text-link">More about us</a>
    </p>
  </section>

  <!-- Support: what happens when something goes wrong. -->
  <section
    aria-labelledby="support"
    id="contact"
    class="mt-16 scroll-mt-24 rounded-xl-inc bg-surface-container p-6 sm:mt-24 sm:rounded-2xl sm:p-10 lg:p-12"
  >
    <h2 id="support" class="font-display text-headline-md sm:text-headline-lg">Help when you need it</h2>
    <p class="mt-2 max-w-xl text-body-lg text-pretty text-on-surface-variant">
      We’re a small team in London, and we answer support and refund requests ourselves.
    </p>
    <div class="mt-6 sm:mt-8">
      <FeatureList features={support} />
    </div>
    <p class="mt-6 flex flex-wrap gap-2 sm:gap-2.5">
      <Chip href="/contact/" icon="send" variant="filled">Contact support</Chip>
      <Chip href={`/blog/tags/${tagSlug('Guides')}/`}>Read the guides</Chip>
      <Chip href="/refund-policy/">Refund policy</Chip>
    </p>
  </section>

  <!-- Blog: latest posts. -->
  <section aria-labelledby="blog" class="mt-16 sm:mt-24">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <h2 id="blog" class="font-display text-headline-lg sm:text-display-sm">Blog</h2>
        <p class="mt-1 text-body-lg text-on-surface-variant">Updates on our apps, and why we made the decisions we did.</p>
      </div>
      <a
        href="/blog/"
        class="inline-flex min-h-10 items-center gap-1 rounded-full px-3 text-label-lg text-primary transition-expressive hover:bg-primary-container hover:text-on-primary-container"
      >
        All posts
        <Icon name="arrow_forward" class="text-[1.125rem]" />
      </a>
    </div>
    {
      latestPosts.length > 0 && (
        <ul class="mt-6 divide-y divide-outline-variant border-y border-outline-variant sm:mt-8">
          {latestPosts.map((post) => (
            <li class="py-1">
              <PostRow post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- For developers. -->
  <section aria-labelledby="open-source" class="mt-16 sm:mt-24">
    <h2 id="open-source" class="font-display text-headline-md sm:text-headline-lg">Open source</h2>
    <p class="mt-2 max-w-2xl text-body-lg text-pretty text-on-surface-variant">
      We publish libraries, developer tools and this website on GitHub.
    </p>
    <p class="mt-6 flex flex-wrap gap-2 sm:gap-2.5">
      <Chip href="/open-source/">Browse repositories</Chip>
      <Chip href={site.github}>
        <svg viewBox="0 0 24 24" class="size-[1.125rem] flex-none" fill="currentColor" aria-hidden="true">
          <path d={brands.github}></path>
        </svg>
        GitHub
      </Chip>
    </p>
  </section>

</Base>
