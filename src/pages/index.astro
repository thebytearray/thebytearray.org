---
import { Image } from 'astro:assets';
import Chip from '../components/Chip.astro';
import Icon from '../components/Icon.astro';
import Shape from '../components/Shape.astro';
import FeatureList from '../components/FeatureList.astro';
import { apps, type AppFeature } from '../data/apps';
import { brands, site } from '../data/site';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts } from '../lib/posts';
import { formatPrice, getPrices } from '../lib/prices';

const latestPosts = (await getPosts()).slice(0, 3);
// Only apps people can still install; free before paid, so the comparison
// reads from the free app to the upgrade.
const liveApps = apps.filter((app) => !app.discontinued).sort((a, b) => Number(!!a.paid) - Number(!!b.paid));
const convertit = apps.find((app) => app.slug === 'convertit')!;

const reasons: AppFeature[] = [
  {
    icon: 'wifi_off',
    title: 'Works without internet',
    description: 'No internet permission. Your files can’t leave your phone.',
  },
  {
    icon: 'lock',
    title: 'No sign up',
    description: 'No ads, no tracking, no account.',
  },
  {
    icon: 'sell',
    title: 'Pay once for Pro',
    description: 'One purchase. No subscription.',
  },
  {
    icon: 'movie',
    title: 'Keeps your quality',
    description: 'HDR10+ survives compression. Lossless FLAC for audio.',
  },
];
const [lead, ...rest] = reasons;

---

<Base
  description="Convertit is a free offline audio and video converter for Android. Convertit Pro adds video compression with HDR10+, lossless audio and image tools for one payment."
>
  <!-- Hero: what we make, with one primary action. -->
  <section class="pt-8 pb-12 sm:pt-14 sm:pb-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center lg:gap-16">
      <div>
        <h1 class="max-w-2xl font-display text-hero text-balance">
          Convert and compress media, <span class="text-primary">offline</span>
        </h1>
        <div class="mt-6 sm:mt-8">
          <p class="max-w-xl text-title-lg font-normal text-pretty text-on-surface-variant">
            A free audio and video converter for Android. Pro adds compression, lossless audio and image tools, for
            one payment.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <Chip href="/apps/compare/" variant="filled">Compare the apps</Chip>
            <Chip href={convertit.playStoreUrl}>
              <svg viewBox="0 0 24 24" class="size-4 flex-none" fill="currentColor" aria-hidden="true">
                <path d={brands.googlePlay}></path>
              </svg>
              Get Convertit on Google Play
            </Chip>
          </div>
        </div>
      </div>

      <!-- The shape holds the two app icons: what we ship, not decoration. -->
      <div aria-hidden="true" class="relative mx-auto aspect-square w-full max-w-[22rem] max-lg:hidden">
        <Shape lobes={9} depth={0.07} class="absolute inset-0 text-primary-container" />
        <div class="absolute inset-0 grid place-items-center">
          <div class="relative h-44 w-56">
            {
              liveApps.slice(0, 2).map((app, i) => (
                <Image
                  src={app.icon}
                  alt=""
                  width={192}
                  height={192}
                  loading="lazy"
                  class:list={[
                    'absolute size-28 rounded-[22%] shadow-level3',
                    i === 0 ? 'top-0 left-0 -rotate-8' : 'right-0 bottom-0 rotate-6',
                  ]}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The apps people can install today, side by side so the choice is quick.
       Past apps live on the Apps page. -->
  <section aria-labelledby="apps-title" id="apps" class="mt-4 scroll-mt-24 sm:mt-6">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <h2 id="apps-title" class="font-display text-headline-lg sm:text-display-sm">Which one do you need?</h2>
      <a
        href="/apps/compare/"
        class="inline-flex min-h-10 items-center gap-1 rounded-full px-3 text-label-lg text-primary transition-expressive hover:bg-primary-container hover:text-on-primary-container"
      >
        Full comparison
        <Icon name="arrow_forward" class="text-[1.125rem]" />
      </a>
    </div>
    <ul class="mt-6 grid gap-3 sm:mt-8 sm:gap-4 md:grid-cols-2">
      {
        liveApps.map((app) => (
          <li class="flex flex-col rounded-xl bg-surface-container p-6 sm:p-8">
            <a href={`/apps/${app.slug}/`} class="group flex items-center gap-4">
              <Image
                src={app.icon}
                alt=""
                width={128}
                height={128}
                loading="lazy"
                class="size-14 flex-none rounded-[22%] sm:size-16"
              />
              <span class="min-w-0">
                <span class="block font-display text-headline-sm group-hover:text-primary group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
                  {app.name}
                </span>
                <span class="text-label-lg text-on-surface-variant">
                  {app.paid ? `One-time purchase: ${getPrices(app).map(formatPrice).join(' · ')}` : 'Free'}
                </span>
              </span>
            </a>
            {app.bestFor && <p class="mt-5 text-body-lg text-pretty">Pick it if {app.bestFor}</p>}
            {
              app.highlights && (
                <ul class="mt-4 flex-1 space-y-2">
                  {app.highlights.map((item) => (
                    <li class="flex gap-3 text-body-md text-on-surface-variant">
                      <Icon name="check" class="mt-0.5 flex-none text-[1.125rem] text-primary" />
                      {item}
                    </li>
                  ))}
                </ul>
              )
            }
            <p class="mt-6 flex flex-wrap gap-2">
              <Chip href={app.playStoreUrl} variant="filled" aria-label={`Get ${app.name} on Google Play`}>
                <svg viewBox="0 0 24 24" class="size-4 flex-none" fill="currentColor" aria-hidden="true">
                  <path d={brands.googlePlay}></path>
                </svg>
                Google Play
              </Chip>
              <Chip href={`/apps/${app.slug}/`} aria-label={`${app.name} details`}>Details</Chip>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Why the free app is free: people rightly ask what they pay with instead. -->
  <section aria-labelledby="why-free" class="mt-16 grid gap-x-10 gap-y-5 sm:mt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <h2 id="why-free" class="font-display text-headline-lg sm:text-display-sm">Why is Convertit free?</h2>
    <ul class="max-w-2xl space-y-3 text-title-lg font-normal text-pretty">
      <li>No ads. No data selling. No internet permission.</li>
      <li>Free features stay free. We won’t lock them later.</li>
      <li>Pro is how we get paid, once.</li>
      <li class="text-body-lg text-on-surface-variant">
        Ideas or problems? <a href="/contact/" class="text-link">Tell us</a>
      </li>
    </ul>
  </section>

  <!-- Why pick Convertit: the offline promise leads, the rest follow as a list. -->
  <section aria-labelledby="why" class="mt-16 sm:mt-24">
    <h2 id="why" class="font-display text-headline-lg sm:text-display-sm">Why pick Convertit</h2>
    <p class="mt-2 max-w-2xl text-body-lg text-pretty text-on-surface-variant">
      Useful apps shouldn’t cost you your privacy.
    </p>
    <div class="mt-6 grid gap-6 sm:mt-8 lg:grid-cols-[5fr_7fr] lg:gap-10">
      <div class="flex flex-col rounded-xl-inc bg-primary-container p-6 text-on-primary-container sm:rounded-2xl sm:p-8">
        <Icon name={lead.icon} class="text-[3rem]" />
        <h3 class="mt-auto pt-10 font-display text-headline-md">{lead.title}</h3>
        <p class="mt-2 text-body-lg text-pretty">{lead.description}</p>
      </div>
      <div>
        <FeatureList features={rest} columns={1} />
        <p class="mt-2">
          <a href="/about/" class="text-link">More about us</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Blog: latest posts. -->
  <section aria-labelledby="blog" class="mt-16 sm:mt-24">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <h2 id="blog" class="font-display text-headline-lg sm:text-display-sm">Blog</h2>
        <p class="mt-1 text-body-lg text-on-surface-variant">App news and how-to guides.</p>
      </div>
      <a
        href="/blog/"
        class="inline-flex min-h-10 items-center gap-1 rounded-full px-3 text-label-lg text-primary transition-expressive hover:bg-primary-container hover:text-on-primary-container"
      >
        All posts
        <Icon name="arrow_forward" class="text-[1.125rem]" />
      </a>
    </div>
    {
      latestPosts.length > 0 && (
        <ul class="mt-6 divide-y divide-outline-variant border-y border-outline-variant sm:mt-8">
          {latestPosts.map((post) => (
            <li class="py-1">
              <PostRow post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- For developers. -->
  <section aria-labelledby="open-source" class="mt-16 sm:mt-24">
    <h2 id="open-source" class="font-display text-headline-md sm:text-headline-lg">Open source</h2>
    <p class="mt-2 max-w-2xl text-body-lg text-pretty text-on-surface-variant">
      Our libraries, tools and this website are on GitHub.
    </p>
    <p class="mt-6 flex flex-wrap gap-2">
      <Chip href="/open-source/">Browse repositories</Chip>
      <Chip href={site.github}>
        <svg viewBox="0 0 24 24" class="size-[1.125rem] flex-none" fill="currentColor" aria-hidden="true">
          <path d={brands.github}></path>
        </svg>
        GitHub
      </Chip>
    </p>
  </section>

</Base>
