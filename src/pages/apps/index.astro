---
import AppRow from '../../components/AppRow.astro';
import PageHeader from '../../components/PageHeader.astro';
import FeaturedApp from '../../components/FeaturedApp.astro';
import { featuredApp, otherApps } from '../../data/apps';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Apps"
  description="Convertit converts audio and video offline. OpenLoader installs APKs on the Android devices you own. Hy2NG is a Hysteria2 VPN client. No ads, no tracking, no accounts."
  breadcrumbs={[{ name: 'Apps', path: '/apps/' }]}
>
  <PageHeader
    title="Apps"
    lede="Mobile apps that do one job well. None of them show ads, track you or ask you to sign up."
    shape="flower"
    accent="triangle"
  />

  {featuredApp && <FeaturedApp app={featuredApp} heading="h2" class="mt-10 sm:mt-14" />}

  <section aria-labelledby="more-apps" class="mt-16 sm:mt-24">
    <h2 id="more-apps" class="font-display text-headline-md text-on-surface-variant">More apps</h2>
    <div class="mt-2 divide-y divide-outline-variant border-y border-outline-variant">
      {
        otherApps.map((app) => (
          <AppRow app={app} heading="h3" />
        ))
      }
    </div>
  </section>

  <p class="mt-12 max-w-prose text-body-lg text-on-surface-variant sm:mt-16">
    Every app is free, with no ads, no tracking and no accounts.{' '}
    <a href="/about/" class="rounded-sm text-primary underline-offset-4 hover:underline">How we work</a>
  </p>
</Base>
