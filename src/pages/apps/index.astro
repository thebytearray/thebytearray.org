---
import AppCard from '../../components/AppCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import FeaturedApp from '../../components/FeaturedApp.astro';
import { featuredApp, otherApps } from '../../data/apps';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Apps"
  description="Convertit converts audio and video offline. OpenLoader installs APKs on the Android devices you own. Hy2NG is a Hysteria2 VPN client. No ads, no tracking, no accounts."
  breadcrumbs={[{ name: 'Apps', path: '/apps/' }]}
>
  <PageHeader
    title="Apps"
    lede="Mobile apps that do one job well. None of them show ads, track you or ask you to sign up."
    shape="flower"
    accent="triangle"
  />

  {featuredApp && <FeaturedApp app={featuredApp} heading="h2" />}
  <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 md:grid-cols-2">
    {
      otherApps.map((app, i) => (
        <AppCard
          app={app}
          heading="h2"
          tone={i % 2 === 0 ? 'primary' : 'tertiary'}
          class:list={[
            'rounded-xl-inc sm:rounded-2xl',
            i === otherApps.length - 1 && 'rounded-br-md sm:rounded-br-md',
          ]}
        />
      ))
    }
  </div>
</Base>
