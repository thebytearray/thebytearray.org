---
import AppRow from '../../components/AppRow.astro';
import PageHeader from '../../components/PageHeader.astro';
import FeaturedApp from '../../components/FeaturedApp.astro';
import { featuredApp, otherApps } from '../../data/apps';

const liveApps = otherApps.filter((app) => !app.discontinued);
const pastApps = otherApps.filter((app) => app.discontinued);
import Base from '../../layouts/Base.astro';
---

<Base
  title="Apps"
  description="Convertit converts audio and video offline for free. Convertit Pro adds video compression, lossless audio and image tools for one payment."
  breadcrumbs={[{ name: 'Apps', path: '/apps/' }]}
>
  <PageHeader
    title="Apps"
    lede="Convertit converts audio and video for free. Convertit Pro adds video compression, lossless audio and image tools for one payment. Both work offline on your phone."
  />

  <!-- The free app first, then the paid one, so the page reads from the free
       app to the upgrade. -->
  {
    liveApps.length > 0 && (
      <div class="mt-6 divide-y divide-outline-variant border-b border-outline-variant sm:mt-8">
        {liveApps.map((app) => (
          <AppRow app={app} heading="h2" />
        ))}
      </div>
    )
  }

  {featuredApp && <FeaturedApp app={featuredApp} heading="h2" class="mt-10 sm:mt-14" />}

  <p class="mt-8 max-w-prose text-body-lg text-on-surface-variant">
    Not sure which? <a href="/apps/compare/" class="text-link">Compare Free and Pro</a>. Prefer to install without Google Play? <a href="/downloads/" class="text-link">Download the APK</a>.
  </p>

  {
    pastApps.length > 0 && (
      <section aria-labelledby="past-apps" class="mt-16 sm:mt-24">
        <h2 id="past-apps" class="font-display text-headline-md text-on-surface-variant">Past apps</h2>
        <p class="mt-2 max-w-prose text-body-lg text-on-surface-variant">
          We no longer maintain these apps. Their pages stay up for people who still use them.
        </p>
        <div class="mt-2 divide-y divide-outline-variant border-y border-outline-variant">
          {pastApps.map((app) => (
            <AppRow app={app} heading="h3" />
          ))}
        </div>
      </section>
    )
  }

  <p class="mt-12 max-w-prose text-body-lg text-on-surface-variant sm:mt-16">
    None of our apps have ads, tracking or accounts. Convertit Pro is a one-time purchase, and the other apps are free.{' '}
    <a href="/about/" class="rounded-sm text-primary underline decoration-1 underline-offset-4 hover:decoration-2">About us</a>
  </p>
</Base>
