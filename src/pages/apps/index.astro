---
import AppCard from '../../components/AppCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { apps } from '../../data/apps';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Apps"
  description="OpenLoader installs APKs on the Android devices you own. Hy2NG is a Hysteria2 VPN client. No ads, no tracking, no accounts."
  breadcrumbs={[{ name: 'Apps', path: '/apps/' }]}
>
  <PageHeader
    title="Apps"
    lede="Android apps that do one job well. None of them show ads, track you or ask you to sign up."
    shape="flower"
    accent="triangle"
  />

  <div class="grid gap-3 sm:gap-4 md:grid-cols-2">
    {
      apps.map((app, i) => (
        <AppCard
          app={app}
          heading="h2"
          tone={i % 2 === 0 ? 'primary' : 'tertiary'}
          class:list={[
            'rounded-xl-inc sm:rounded-2xl',
            i === 0 && 'rounded-tl-md sm:rounded-tl-md',
            i === apps.length - 1 && 'rounded-br-md sm:rounded-br-md',
          ]}
        />
      ))
    }
  </div>
</Base>
