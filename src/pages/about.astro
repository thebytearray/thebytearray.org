---
import Chip from '../components/Chip.astro';
import FeatureList from '../components/FeatureList.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { apps } from '../data/apps';
import { brands, site, team, workAreas } from '../data/site';
import Base from '../layouts/Base.astro';

const section = 'grid gap-x-10 gap-y-5 lg:grid-cols-[11rem_1fr]';
const sectionTitle = 'font-display text-headline-md text-balance';
// Same round icon button as the footer's social links.
const iconLink =
  'grid size-11 place-items-center rounded-[1.375rem] transition-expressive hover:rounded-lg hover:bg-secondary-container hover:text-on-secondary-container';
---

<Base
  title="About"
  description="The Byte Array makes software that solves real problems without trading away your privacy: mobile apps, libraries and developer tools."
  breadcrumbs={[{ name: 'About', path: '/about/' }]}
>
  <div data-pagefind-body>
    <PageHeader
      title="About The Byte Array"
      lede="We’re The Byte Array, a small software company. We make mobile apps, libraries and developer tools, and much of our code is open source."
      shape="cookie"
      tone="primary"
    />

    <div class="flex flex-col gap-16 sm:gap-24">
      <section aria-labelledby="data" class={section}>
        <h2 id="data" class={sectionTitle}>Why we exist</h2>
        <div class="max-w-2xl space-y-4 text-body-lg text-pretty">
          <p>
            We make software that solves real problems without trading away your privacy.
          </p>
          <p>
            Our apps run on your device. They don’t include analytics, ads or tracking, and you don’t need an account
            to use them. If an app needs the internet, it only connects to devices or servers you choose.
          </p>
          <p>
            We share our code when it can help others, and we keep our policies short so you can read them quickly. Read
            the full policies for{' '}
            {
              apps.filter((app) => app.privacyPath).map((app, i) => (
                <>
                  {i > 0 && ' and '}
                  <a href={app.privacyPath} class="text-link">{app.name}</a>
                </>
              ))
            }.
          </p>
        </div>
      </section>

      <section aria-labelledby="what-we-build" class={section}>
        <h2 id="what-we-build" class={sectionTitle}>What we make</h2>
        <FeatureList features={workAreas} columns={3} />
      </section>

      <section aria-labelledby="license" class={section}>
        <h2 id="license" class={sectionTitle}>Open source</h2>
        <div>
          <p class="max-w-2xl text-body-lg text-pretty">
            OpenLoader and this website are open source under {site.license.name}. Our libraries and tools are also
            published on GitHub.
          </p>
          <ul class="mt-7 flex flex-wrap gap-2 sm:gap-2.5">
            <li><Chip href="/open-source/" variant="filled">Browse repositories</Chip></li>
            <li>
              <Chip href={site.github}>
                <svg viewBox="0 0 24 24" class="size-[1.125rem] flex-none" fill="currentColor" aria-hidden="true">
                  <path d={brands.github}></path>
                </svg>
                GitHub
              </Chip>
            </li>
          </ul>
        </div>
      </section>
      <section aria-labelledby="team" class={section}>
        <h2 id="team" class={sectionTitle}>Team</h2>
        <ul class="grid gap-3 sm:gap-4 lg:grid-cols-3">
          {
            team.map((member) => (
              <li class="flex items-start gap-4 rounded-xl bg-surface-container p-6 lg:flex-col">
                {member.avatar ? (
                  <img
                    src={member.avatar}
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                    class="size-14 flex-none rounded-full bg-surface-container-highest"
                  />
                ) : (
                  <span
                    aria-hidden="true"
                    class="grid size-14 flex-none place-items-center rounded-full bg-primary-container font-display text-title-lg text-on-primary-container"
                  >
                    {member.name.charAt(0)}
                  </span>
                )}
                <div class="min-w-0">
                  <h3 class="font-display text-title-lg">{member.name}</h3>
                  <p class="text-body-md text-on-surface-variant">{member.role}</p>
                  {member.bio && <p class="mt-2 text-body-md">{member.bio}</p>}
                  {(member.github || member.website) && (
                    <ul class="mt-3 -ml-3 flex items-center gap-1 text-on-surface-variant">
                      {member.github && (
                        <li>
                          <a
                            href={member.github}
                            target="_blank"
                            rel="noopener"
                            aria-label={`${member.name} on GitHub`}
                            title="GitHub"
                            class={iconLink}
                          >
                            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
                              <path d={brands.github}></path>
                            </svg>
                          </a>
                        </li>
                      )}
                      {member.website && (
                        <li>
                          <a
                            href={member.website}
                            target="_blank"
                            rel="noopener"
                            aria-label={`${member.name}’s website`}
                            title="Website"
                            class:list={['fill-on-hover', iconLink]}
                          >
                            <Icon name="link" class="text-[1.375rem]" />
                          </a>
                        </li>
                      )}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="company" class={section}>
        <h2 id="company" class={sectionTitle}>Company</h2>
        <div class="max-w-2xl text-body-lg text-pretty">
          <address class="not-italic">
            {site.company.name}<br />
            {site.company.office}
          </address>
          <p class="mt-2 text-on-surface-variant">
            Registered in {site.company.jurisdiction}, no.{' '}
            <a href={site.company.url} target="_blank" rel="noopener" class="text-link">{site.company.number}</a>
          </p>
          <p class="mt-6"><Chip href="/contact/" icon="send" variant="filled">Contact us</Chip></p>
        </div>
      </section>
    </div>
  </div>
</Base>
