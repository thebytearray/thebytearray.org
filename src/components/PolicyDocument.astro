---
import '../styles/prose.css';

import { getApp } from '../data/apps';
import { type Policy, unlistedApps } from '../data/policies';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  policy: Policy;
  description: string;
}

const { policy, description } = Astro.props;
// Apps without a page on the site are named but not linked.
const app = policy.app in unlistedApps ? undefined : getApp(policy.app);
const appName = app?.name ?? unlistedApps[policy.app as keyof typeof unlistedApps].name;
const lastUpdatedDate = new Date(policy.lastUpdated);
const lastUpdatedDisplay = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'UTC',
  timeZoneName: 'short',
}).format(lastUpdatedDate);
---

<Base
  title={policy.title}
  description={description}
  breadcrumbs={[
    { name: 'Legal', path: '/legal/' },
    { name: policy.title, path: Astro.url.pathname },
  ]}
>
  <div class="mx-auto max-w-2xl pt-4 sm:pt-10" data-pagefind-body>
    <Breadcrumbs items={[{ label: 'Legal', href: '/legal/' }, { label: policy.title }]} />

    <header class="mt-6 sm:mt-8">
      <h1
        class="font-display text-page-title text-balance"
      >
        {policy.title}
      </h1>
      <p class="mt-4 text-label-lg text-on-surface-variant">
        Last updated <time datetime={lastUpdatedDate.toISOString()}>{lastUpdatedDisplay}</time>
      </p>
      <p class="mt-2 text-body-md text-on-surface-variant">
        Applies to {app ? <a href={`/apps/${app.slug}/`} class="text-link">{appName}</a> : appName}.
      </p>
    </header>

    <article class="prose mt-10 sm:mt-12">
      {
        policy.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.blocks.map((block) =>
              block.type === 'paragraph' ? (
                <p>{block.text}</p>
              ) : (
                <ul>
                  {block.items.map((item) => (
                    <li>
                      <strong>{item.term}:</strong> {item.text}
                    </li>
                  ))}
                </ul>
              ),
            )}
          </section>
        ))
      }

      <section>
        <h2>Contact</h2>
        <p>
          If you have questions about this privacy policy, contact us at{' '}
          <button type="button" data-mailto={site.mail} class="text-link">{site.emailDisplay}</button>.
        </p>
      </section>
    </article>
  </div>
</Base>
