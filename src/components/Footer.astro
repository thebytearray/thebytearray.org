---
import { apps } from '../data/apps';
import { brands, site } from '../data/site';
import { getPosts } from '../lib/posts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const hasPosts = (await getPosts()).length > 0;

const columns = [
  {
    title: 'Apps',
    links: apps.map((app) => ({ label: app.name, href: `/apps/${app.slug}/` })),
  },
  {
    title: 'Privacy',
    links: [
      ...apps.flatMap((app) =>
        app.privacyPath ? [{ label: `${app.name} privacy`, href: app.privacyPath }] : [],
      ),
      { label: 'Site privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
    ],
  },
  {
    title: 'Studio',
    links: [
      { label: 'Downloads', href: '/downloads/' },
      { label: 'Open source', href: '/open-source/' },
      ...(hasPosts ? [{ label: 'Blog', href: '/blog/' }] : []),
      { label: 'About', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Refund policy', href: '/refund-policy/' },
    ],
  },
];

const iconLink =
  'grid size-11 place-items-center rounded-[1.375rem] transition-expressive hover:rounded-lg hover:bg-secondary-container hover:text-on-secondary-container';
---

<footer class="mx-auto mt-20 w-full max-w-6xl px-4 pb-8 sm:mt-28 sm:px-8 sm:pb-10">
  <div class="grid gap-10 rounded-xl-inc bg-surface-container p-6 sm:rounded-2xl sm:p-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <a href="/" class="inline-flex items-center gap-3 rounded-full pr-2" aria-label={`${site.name}, home`}>
        <Logo class="size-10" />
        <span class="font-display text-title-lg font-semibold tracking-tight" aria-hidden="true">{site.name}</span>
      </a>
      <p class="mt-3 max-w-xs text-body-md text-on-surface-variant">
        Private apps and developer tools that get straight to the point.
      </p>
      <ul class="mt-4 -ml-2.5 flex items-center gap-1 text-on-surface-variant">
        <li>
          <a href={site.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub" class={iconLink}>
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
              <path d={brands.github}></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href={site.youtube}
            target="_blank"
            rel="noopener"
            aria-label="YouTube"
            title="YouTube"
            class={iconLink}
          >
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
              <path d={brands.youtube}></path>
            </svg>
          </a>
        </li>
        <li>
          <button
            type="button"
            data-mailto={site.mail}
            aria-label={`Email ${site.emailDisplay}`}
            title="Email us"
            class:list={['fill-on-hover', iconLink]}
          >
            <Icon name="mail" class="text-[1.375rem]" />
          </button>
        </li>
        <li>
          <a href="/rss.xml" aria-label="RSS feed" title="RSS feed" class:list={['fill-on-hover', iconLink]}>
            <Icon name="rss_feed" class="text-[1.375rem]" />
          </a>
        </li>
      </ul>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="font-display text-title-md">{column.title}</h2>
            <ul class="mt-3 flex flex-col gap-2.5 text-body-md">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="rounded-sm text-on-surface-variant transition-colors duration-(--duration-short4) hover:text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="mt-5 flex flex-col gap-x-8 gap-y-1 px-2 text-body-md text-on-surface-variant sm:flex-row sm:justify-between">
    <p>&copy; {year} {site.company.name}</p>
    <p>
      This website is open source under{' '}
      <a
        href={site.repo}
        target="_blank"
        rel="noopener"
        class="rounded-sm underline decoration-1 underline-offset-4 hover:text-primary">{site.license.name}</a
      >.
    </p>
  </div>

  <p class="mt-1 px-2 text-body-sm text-on-surface-variant">
    Registered in {site.company.jurisdiction}, no.{' '}
    <a
      href={site.company.url}
      target="_blank"
      rel="noopener"
      class="rounded-sm underline decoration-1 underline-offset-4 hover:text-primary">{site.company.number}</a
    >
  </p>
</footer>
