---
import { apps } from '../data/apps';
import { brands, site } from '../data/site';
import { getPosts } from '../lib/posts';
import Chip from './Chip.astro';
import ColorPicker from './ColorPicker.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
// The contact page already is the help; skip the band there.
const showHelp = !Astro.url.pathname.startsWith('/contact');
const hasPosts = (await getPosts()).length > 0;

const columns = [
  {
    title: 'Apps',
    links: [
      ...apps.filter((app) => !app.discontinued).map((app) => ({ label: app.name, href: `/apps/${app.slug}/` })),
      { label: 'Downloads', href: '/downloads/' },
      { label: 'All apps', href: '/apps/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Open source', href: '/open-source/' },
      ...(hasPosts ? [{ label: 'Blog', href: '/blog/' }] : []),
      { label: 'Contact', href: '/contact/' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Refund policy', href: '/refund-policy/' },
      { label: 'All legal pages', href: '/legal/' },
    ],
  },
];

const iconLink =
  'grid size-11 place-items-center rounded-[1.375rem] transition-expressive hover:rounded-lg hover:bg-secondary-container hover:text-on-secondary-container';
---

<footer class="mx-auto mt-20 w-full max-w-6xl px-4 pb-8 sm:mt-28 sm:px-8 sm:pb-10">
  {
    showHelp && (
      <section
        id="contact"
        aria-labelledby="footer-help"
        class="mb-10 flex scroll-mt-24 flex-col gap-4 rounded-xl-inc bg-surface-container p-6 sm:mb-14 sm:flex-row sm:items-center sm:justify-between sm:rounded-2xl sm:p-8"
      >
        <div>
          <h2 id="footer-help" class="font-display text-headline-sm">Need help?</h2>
          <p class="mt-1 text-body-md text-on-surface-variant">We aim to reply within 5 business days.</p>
        </div>
        <p class="flex flex-wrap gap-2">
          <Chip href="/contact/" icon="send" variant="filled">Contact support</Chip>
          <Chip href="/refund-policy/">Refund policy</Chip>
        </p>
      </section>
    )
  }
  <div class="grid gap-10 border-t border-outline-variant pt-10 sm:pt-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <a href="/" class="inline-flex items-center gap-3 rounded-full pr-2" aria-label={`${site.name}, home`}>
        <Logo class="size-10" />
        <span class="font-display text-title-lg font-semibold tracking-tight" aria-hidden="true">{site.name}</span>
      </a>
      <p class="mt-3 max-w-xs text-body-md text-on-surface-variant">
        We make offline Android apps for audio, video and images, and open-source developer tools.
      </p>
      <ul class="mt-4 -ml-3 flex items-center gap-1 text-on-surface-variant">
        <li>
          <a href={site.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub" class={iconLink}>
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
              <path d={brands.github}></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href={site.youtube}
            target="_blank"
            rel="noopener"
            aria-label="YouTube"
            title="YouTube"
            class={iconLink}
          >
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
              <path d={brands.youtube}></path>
            </svg>
          </a>
        </li>
        <li>
          <button
            type="button"
            data-mailto={site.mail}
            aria-label={`Email ${site.emailDisplay}`}
            title="Email us"
            class:list={['fill-on-hover', iconLink]}
          >
            <Icon name="mail" class="text-[1.375rem]" />
          </button>
        </li>
        <li>
          <a href="/rss.xml" aria-label="RSS feed" title="RSS feed" class:list={['fill-on-hover', iconLink]}>
            <Icon name="rss_feed" class="text-[1.375rem]" />
          </a>
        </li>
      </ul>
      <div class="mt-4 flex items-center gap-2">
        <span class="text-label-md text-on-surface-variant">Accent</span>
        <ColorPicker />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="font-display text-title-md">{column.title}</h2>
            <ul class="mt-3 flex flex-col gap-2 text-body-md">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="rounded-sm text-on-surface-variant transition-colors duration-(--duration-short4) hover:text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="mt-12 flex flex-col gap-x-8 gap-y-1 border-t border-outline-variant pt-6 text-body-md text-on-surface-variant sm:flex-row sm:justify-between">
    <p>&copy; {year} {site.company.name}</p>
    <p>
      This website is open source under{' '}
      <a
        href={site.repo}
        target="_blank"
        rel="noopener"
        class="rounded-sm underline decoration-1 underline-offset-4 hover:text-primary">{site.license.name}</a
      >.
    </p>
  </div>

  <p class="mt-1 text-body-sm text-on-surface-variant">
    Registered in {site.company.jurisdiction}, no.{' '}
    <a
      href={site.company.url}
      target="_blank"
      rel="noopener"
      class="rounded-sm underline decoration-1 underline-offset-4 hover:text-primary">{site.company.number}</a
    >
  </p>
</footer>
