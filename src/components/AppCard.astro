---
import { Image } from 'astro:assets';
import type { App } from '../data/apps';
import { brands } from '../data/site';
import Chip from './Chip.astro';

interface Props {
  app: App;
  tone?: 'primary' | 'tertiary' | 'surface';
  /** Heading level of the app name, to fit the page outline. */
  heading?: 'h2' | 'h3';
  class?: string;
}

const { app, tone = 'surface', heading: Heading = 'h3', class: className } = Astro.props;
const details = `/apps/${app.slug}/`;

const tones = {
  primary: 'bg-primary-container text-on-primary-container',
  tertiary: 'bg-tertiary-container text-on-tertiary-container',
  surface: 'bg-surface-container text-on-surface',
};
---

<!-- One app, summarised: icon, what it does, two actions, and a glimpse of the UI. -->
<article class:list={['flex flex-col overflow-clip', tones[tone], className]}>
  <div class="flex flex-1 flex-col gap-5 p-6 sm:gap-6 sm:p-8 lg:p-9">
    <div class="flex items-center gap-4">
      <Image src={app.icon} alt="" width={128} height={128} class="size-14 flex-none rounded-[22%] sm:size-16" />
      <div class="min-w-0">
        <Heading class="font-display text-headline-md sm:text-headline-lg">
          <a href={details} class="rounded-sm decoration-2 underline-offset-4 hover:underline">{app.name}</a>
        </Heading>
        <p class="text-body-md opacity-85">{app.tagline}</p>
      </div>
    </div>
    <p class="max-w-prose text-body-lg text-pretty">{app.summary}</p>
    <ul class="mt-auto flex flex-wrap gap-2">
      <li>
        <Chip href={details} variant="filled" aria-label={`${app.name} details`}>Details</Chip>
      </li>
      <li>
        <Chip
          href={app.playStoreUrl}
          class="border-transparent bg-surface text-on-surface"
          aria-label={`Get ${app.name} on Google Play`}
        >
          <svg viewBox="0 0 24 24" class="size-4 flex-none" fill="currentColor" aria-hidden="true">
            <path d={brands.googlePlay}></path>
          </svg>
          Google Play
        </Chip>
      </li>
    </ul>
  </div>

  <!-- A glimpse of the app; full, described screenshots are on the details page. -->
  <div
    aria-hidden="true"
    class="flex h-52 justify-center gap-3 overflow-hidden bg-[color-mix(in_srgb,currentColor_8%,transparent)] px-6 pt-7 sm:h-60 sm:gap-4"
  >
    {
      app.screenshots.slice(0, 3).map((shot, i) => (
        <Image
          src={shot.src}
          alt=""
          widths={[160, 320]}
          sizes="9rem"
          class:list={[
            'h-auto w-[30%] max-w-36 self-start rounded-t-lg-inc object-cover object-top shadow-level2',
            i === 1 ? '-mt-3' : 'mt-2',
          ]}
        />
      ))
    }
  </div>
</article>
