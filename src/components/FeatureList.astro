---
import type { AppFeature } from '../data/apps';
import Icon from './Icon.astro';

interface Props {
  features: AppFeature[];
}

const { features } = Astro.props;
---

<ul class="grid gap-x-10 sm:grid-cols-2">
  {
    features.map(({ icon, title, description }) => (
      <li class="flex gap-4 border-t border-outline-variant py-5 sm:py-6">
        <span class="grid size-10 flex-none place-items-center rounded-lg bg-primary-container text-on-primary-container">
          <Icon name={icon} class="text-[1.375rem]" />
        </span>
        <div>
          <h3 class="font-display text-title-lg leading-tight">{title}</h3>
          <p class="mt-1 text-body-md text-on-surface-variant">{description}</p>
        </div>
      </li>
    ))
  }
</ul>
