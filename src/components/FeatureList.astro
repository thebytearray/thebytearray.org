---
import type { AppFeature } from '../data/apps';
import Icon from './Icon.astro';

interface Props {
  features: AppFeature[];
  /** Three short items read better in one row than as a two-column list with a
   * gap; 1 stacks them for a narrow column. */
  columns?: 1 | 2 | 3;
}

const { features, columns = 2 } = Astro.props;
---

<ul class:list={['grid gap-x-10', columns === 3 && 'md:grid-cols-3', columns === 2 && 'sm:grid-cols-2']}>
  {
    features.map(({ icon, title, description }) => (
      <li class="flex gap-4 border-t border-outline-variant py-5 sm:py-6">
        <Icon name={icon} class="mt-0.5 text-[1.5rem] text-on-surface-variant" />
        <div>
          <h3 class="font-display text-title-lg leading-tight">{title}</h3>
          <p class="mt-1 text-body-md text-on-surface-variant">{description}</p>
        </div>
      </li>
    ))
  }
</ul>
