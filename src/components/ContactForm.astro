---
import { site } from '../data/site';
import Chip from './Chip.astro';
import Icon from './Icon.astro';

const topics = [
  { id: 'support', label: 'Help with an app' },
  { id: 'collaboration', label: 'Working together' },
  { id: 'other', label: 'Something else' },
];

// mailto: links get unreliable past a couple of thousand characters.
const maxMessage = 1500;
---

<!--
  There is no server behind this form: sending opens the visitor's mail app
  with the message filled in. The address is decoded only at that moment.
-->
<div data-contact data-mail={site.mail} data-max={maxMessage}>
  <form data-form novalidate aria-label="Contact form" class="flex flex-col gap-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="field">
        <label class="field-label" for="contact-name">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder="Your name"
          aria-describedby="contact-name-error"
          class="field-input"
        />
        <p id="contact-name-error" class="field-error" hidden></p>
      </div>

      <div class="field">
        <label class="field-label" for="contact-email">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="name@example.com"
          aria-describedby="contact-email-error"
          class="field-input"
        />
        <p id="contact-email-error" class="field-error" hidden></p>
      </div>
    </div>

    <div class="field" data-topic>
      <label class="field-label" for="contact-topic-button">What is it about?</label>
      <span class="relative block">
        <button
          type="button"
          id="contact-topic-button"
          role="combobox"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="contact-topic-menu"
          aria-required="true"
          aria-describedby="contact-topic-error"
          data-topic-button
          class="field-input flex w-full items-center justify-between gap-3 text-left"
        >
          <span id="contact-topic-text" data-topic-text class="text-on-surface-variant">Choose a topic</span>
          <Icon
            name="expand_more"
            class="text-[1.5rem] text-on-surface-variant transition-transform duration-(--duration-short4)"
          />
        </button>
        <span
          id="contact-topic-menu"
          role="listbox"
          aria-label="Topic"
          data-topic-menu
          hidden
          class="absolute inset-x-0 top-full z-10 mt-2 rounded-xl-inc bg-surface-container-high p-2 shadow-level3"
        >
          {
            topics.map(({ id, label }) => (
              <span
                role="option"
                id={`contact-topic-option-${id}`}
                aria-selected="false"
                data-value={id}
                data-label={label}
                class="flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-left text-body-md transition-colors duration-(--duration-short4) data-[active]:bg-secondary-container data-[active]:text-on-secondary-container"
              >
                <Icon name="check" class="hidden text-[1.25rem]" />
                {label}
              </span>
            ))
          }
        </span>
      </span>
      <input type="hidden" id="contact-topic" name="topic" data-topic-value />
      <p id="contact-topic-error" class="field-error" hidden></p>
    </div>

    <div class="field">
      <label class="field-label" for="contact-message">Message</label>
      <textarea
        id="contact-message"
        name="message"
        required
        rows="6"
        placeholder="How can we help?"
        aria-describedby="contact-message-error contact-message-count"
        class="field-input resize-y"></textarea>
      <p id="contact-message-error" class="field-error" hidden></p>
      <p id="contact-message-count" data-counter class="field-hint tabular-nums">
        0 / {maxMessage.toLocaleString('en-US')} characters
      </p>
    </div>

    <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-body-md text-on-surface-variant">This opens your email app with the message ready to send.</p>
      <button type="submit" class="chip chip-filled fill-on-hover h-12 flex-none justify-center px-6">
        <Icon name="send" class="text-[1.125rem]" />
        Open email app
      </button>
    </div>

    <noscript>
      <p class="text-body-md text-on-surface-variant">
        This form needs JavaScript. You can also email us at {site.emailDisplay}.
      </p>
    </noscript>
  </form>

  <div data-sent hidden role="status" tabindex="-1" class="flex flex-col items-start gap-4 outline-none">
    <span class="grid size-14 place-items-center rounded-full bg-primary-container text-on-primary-container">
      <Icon name="check_circle" class="text-[1.75rem]" />
    </span>
    <div>
      <h2 class="font-display text-headline-sm">Your email app should now be open</h2>
      <p class="mt-2 text-on-surface-variant">
        We’ve filled in your message. Press send in your email app to reach us. If nothing opened, email{' '}
        <span class="font-medium text-on-surface">{site.emailDisplay}</span> directly.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <Chip button icon="content_copy" data-mail={site.mail}>
        <span data-mail-label aria-live="polite">Copy email</span>
      </Chip>
      <Chip button data-again>Write another message</Chip>
    </div>
  </div>
</div>

<script>
  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  function setup(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const sent = root.querySelector<HTMLElement>('[data-sent]')!;
    const counter = root.querySelector<HTMLElement>('[data-counter]')!;
    const max = Number(root.dataset.max);
    const fields = [...form.querySelectorAll<Field>('[name]')];
    const field = (name: string) => form.elements.namedItem(name) as Field;
    const limit = max.toLocaleString('en-US');

    // Material 3 exposed dropdown menu for the topic field. The chosen value
    // lives in a hidden input so the existing validation still applies; the
    // visible button carries focus and the invalid state instead.
    const topicButton = root.querySelector<HTMLButtonElement>('[data-topic-button]')!;
    const topicMenu = root.querySelector<HTMLElement>('[data-topic-menu]')!;
    const topicOptions = [...topicMenu.querySelectorAll<HTMLElement>('[role=option]')];
    const topicText = root.querySelector<HTMLElement>('[data-topic-text]')!;
    const topicChevron = topicButton.querySelector<HTMLElement>('.icon')!;
    const topicValue = field('topic') as HTMLInputElement;
    const topicLabel = () =>
      topicOptions.find((option) => option.dataset.value === topicValue.value)?.dataset.label ?? '';

    /** The problem with a field's current value, or '' when it is fine. */
    function problem({ name, value }: Field): string {
      const text = value.trim();
      switch (name) {
        case 'name':
          if (!text) return 'Enter your name.';
          return text.length > 100 ? 'Keep your name under 100 characters.' : '';
        case 'email':
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(text) ? '' : 'Enter an email address like name@example.com.';
        case 'topic':
          return text ? '' : 'Choose what your message is about.';
        case 'message':
          if (text.length < 10) return 'Write at least 10 characters so we know how to help.';
          return text.length > max ? `Keep it under ${limit} characters, or email us directly.` : '';
        default:
          return '';
      }
    }

    function validate(input: Field): boolean {
      const text = problem(input);
      const error = document.getElementById(`${input.id}-error`)!;
      error.textContent = text;
      error.hidden = !text;
      // The topic value lives in a hidden input; its visible button shows the state.
      const control = input === topicValue ? topicButton : input;
      if (text) control.setAttribute('aria-invalid', 'true');
      else control.removeAttribute('aria-invalid');
      // The message field shows either its error or its character count.
      if (input.name === 'message') counter.hidden = Boolean(text);
      return !text;
    }

    function count() {
      counter.textContent = `${field('message').value.length.toLocaleString('en-US')} / ${limit} characters`;
    }

    function highlight(target: HTMLElement | undefined) {
      for (const option of topicOptions) option.toggleAttribute('data-active', option === target);
      if (target) topicButton.setAttribute('aria-activedescendant', target.id);
      else topicButton.removeAttribute('aria-activedescendant');
    }

    /** Mark the committed value; the highlighted option is tracked separately. */
    function select(target: HTMLElement | undefined) {
      for (const option of topicOptions) option.setAttribute('aria-selected', String(option === target));
    }

    function openMenu() {
      if (!topicMenu.hidden) return;
      topicMenu.hidden = false;
      topicButton.setAttribute('aria-expanded', 'true');
      topicChevron.classList.add('rotate-180');
      highlight(topicOptions.find((option) => option.dataset.value === topicValue.value) ?? topicOptions[0]);
    }

    function closeMenu() {
      if (topicMenu.hidden) return;
      topicMenu.hidden = true;
      topicButton.setAttribute('aria-expanded', 'false');
      topicChevron.classList.remove('rotate-180');
      highlight(undefined);
    }

    function commit(option: HTMLElement) {
      topicValue.value = option.dataset.value ?? '';
      topicText.textContent = option.dataset.label ?? '';
      topicText.classList.remove('text-on-surface-variant');
      for (const other of topicOptions) other.querySelector('.icon')?.classList.toggle('hidden', other !== option);
      select(option);
      closeMenu();
      validate(topicValue);
      topicButton.focus();
    }

    function resetTopic() {
      topicValue.value = '';
      topicText.textContent = 'Choose a topic';
      topicText.classList.add('text-on-surface-variant');
      for (const option of topicOptions) option.querySelector('.icon')?.classList.add('hidden');
      select(undefined);
      closeMenu();
    }

    topicButton.addEventListener('click', () => (topicMenu.hidden ? openMenu() : closeMenu()));

    for (const option of topicOptions) {
      option.addEventListener('click', () => commit(option));
      option.addEventListener('pointermove', () => highlight(option));
    }

    topicButton.addEventListener('keydown', (event) => {
      const current = topicOptions.findIndex((option) => option.hasAttribute('data-active'));
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (topicMenu.hidden) openMenu();
        else {
          const step = event.key === 'ArrowDown' ? 1 : -1;
          highlight(topicOptions[(current + step + topicOptions.length) % topicOptions.length]);
        }
      } else if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        if (topicMenu.hidden) openMenu();
        else if (topicOptions[current]) commit(topicOptions[current]);
      } else if (event.key === 'Escape' && !topicMenu.hidden) {
        closeMenu();
      }
    });

    document.addEventListener('click', (event) => {
      if (!root.isConnected || topicMenu.hidden) return;
      if (event.target instanceof Element && event.target.closest('[data-topic]')) return;
      closeMenu();
    });

    root.addEventListener('focusout', (event) => {
      if (topicMenu.hidden) return;
      if (event.relatedTarget instanceof Element && event.relatedTarget.closest('[data-topic]')) return;
      closeMenu();
    });

    for (const input of fields) {
      // Check a field once it has been left, then keep its error up to date.
      input.addEventListener('blur', () => validate(input));
      input.addEventListener('input', () => {
        if (input.name === 'message') count();
        if (input.hasAttribute('aria-invalid')) validate(input);
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const invalid = fields.filter((input) => !validate(input));
      if (invalid.length > 0) return (invalid[0] === topicValue ? topicButton : invalid[0]).focus();

      const name = field('name').value.trim();
      const email = field('email').value.trim();
      const subject = `${topicLabel()}: message from ${name}`;
      const body = `${field('message').value.trim()}\n\n${name}\n${email}`;
      location.assign(
        `mailto:${atob(root.dataset.mail!)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`,
      );

      form.hidden = true;
      sent.hidden = false;
      sent.focus();
    });

    root.querySelector('[data-again]')!.addEventListener('click', () => {
      form.reset();
      resetTopic();
      for (const input of fields) {
        // A fresh form shows no errors until it is used.
        input.removeAttribute('aria-invalid');
        document.getElementById(`${input.id}-error`)!.hidden = true;
      }
      counter.hidden = false;
      count();
      sent.hidden = true;
      form.hidden = false;
      field('name').focus();
    });
  }

  function init() {
    for (const root of document.querySelectorAll<HTMLElement>('[data-contact]:not([data-ready])')) {
      root.dataset.ready = '';
      setup(root);
    }
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
