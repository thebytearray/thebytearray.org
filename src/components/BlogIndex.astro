---
import { getTags, tagSlug, type Post } from '../lib/posts';
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import PageHeader from './PageHeader.astro';
import PostRow from './PostRow.astro';

interface Props {
  /** The posts to list (already filtered when on a tag page). */
  posts: Post[];
  /** Every post, used to build the tag chips. */
  allPosts: Post[];
  activeTag?: string;
}

const { posts, allPosts, activeTag } = Astro.props;
const tags = getTags(allPosts);

const years = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}
---

<PageHeader
  title={activeTag ? `#${activeTag}` : 'Blog'}
  lede={activeTag
    ? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged “${activeTag}”.`
    : 'Product updates and notes from The Byte Array.'}
/>

<div
  class:list={[
    'mb-8 flex flex-wrap items-start justify-between gap-x-6 gap-y-3 sm:mb-12',
    allPosts.length === 0 && 'hidden',
  ]}
>
<nav aria-label="Filter by tag">
  <ul class="flex flex-wrap gap-2 sm:gap-2.5">
    <li>
      <Chip href="/blog/" variant={activeTag ? 'outlined' : 'filled'} aria-current={activeTag ? undefined : 'page'}>
        All
        <span class="opacity-70">{allPosts.length}</span>
      </Chip>
    </li>
    {
      tags.map(({ tag, count }) => (
        <li>
          <Chip
            href={`/blog/tags/${tagSlug(tag)}/`}
            variant={tag === activeTag ? 'filled' : 'outlined'}
            aria-current={tag === activeTag ? 'page' : undefined}
          >
            {tag}
            <span class="opacity-70">{count}</span>
          </Chip>
        </li>
      ))
    }
  </ul>
</nav>
<!-- Opens the search dialog (components/CommandPalette.astro), limited to blog posts. -->
<button
  type="button"
  data-palette-open="posts"
  class="inline-flex min-h-10 flex-none items-center gap-2 rounded-full px-3 text-label-lg text-primary transition-expressive hover:bg-primary-container hover:text-on-primary-container"
>
  <Icon name="search" class="text-[1.125rem]" />
  Search posts
</button>
</div>

<div class="flex flex-col gap-10 sm:gap-12">
  {
    [...years].map(([year, yearPosts]) => (
      <section aria-labelledby={`y${year}`} class="grid gap-x-10 gap-y-3 lg:grid-cols-[11rem_1fr]">
        <h2 id={`y${year}`} class="font-display text-headline-md text-on-surface-variant">
          {year}
        </h2>
        <ul class="divide-y divide-outline-variant border-y border-outline-variant">
          {yearPosts.map((post) => (
            <li class="py-1">
              <PostRow post={post} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  {
    posts.length === 0 && (
      <p class="max-w-prose text-body-lg text-on-surface-variant">
        No posts yet. The first one will show up here and in the <a href="/rss.xml" class="text-primary underline underline-offset-4">RSS feed</a>.
      </p>
    )
  }
</div>
