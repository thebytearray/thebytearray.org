---
import { formatDate, readingTime, type Post } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, draft, author } = post.data;
---

<div class="@container">
<a
  href={`/blog/${post.id}/`}
  class="group -mx-3 grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1.5 rounded-xl px-3 py-4 transition-expressive hover:rounded-2xl hover:bg-surface-container active:bg-surface-container-high active:duration-(--duration-press) @2xl:-mx-4 @2xl:grid-cols-[7.5rem_1fr_auto] @2xl:gap-x-6 @2xl:px-4 @2xl:py-5"
>
  <p class="col-span-2 text-label-lg text-on-surface-variant @2xl:col-span-1">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="@2xl:hidden"> · {readingTime(post.body)} min read · {author}</span>
    <span class="hidden @2xl:mt-1 @2xl:block">{author}</span>
  </p>
  <div class="min-w-0">
    <h3 class="font-display text-title-lg text-balance transition-colors @2xl:text-headline-sm duration-(--duration-short4) group-hover:text-primary">
      {title}
      {draft && <span class="chip chip-sm chip-tonal ml-2 align-middle font-sans text-tertiary">Draft</span>}
    </h3>
    <p class="mt-1 text-body-md text-on-surface-variant">{description}</p>
  </div>
  <div class="flex items-center gap-5 text-label-lg text-on-surface-variant">
    <span class="hidden whitespace-nowrap @2xl:inline">{readingTime(post.body)} min read</span>
    <Icon
      name="arrow_forward"
      class="flex-none transition-expressive group-hover:translate-x-1 group-hover:text-primary"
    />
  </div>
</a>
</div>
