---
import Icon from './Icon.astro';

interface Props {
  /** The trail below Home. The last item is the current page and needs no `href`. */
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="-ml-3 flex flex-wrap items-center text-label-lg text-on-surface-variant">
    {
      items.map(({ label, href }, i) => (
        <li class="flex items-center">
          {i > 0 && <Icon name="chevron_right" class="text-[1.125rem] opacity-70" />}
          {href ? (
            <a
              href={href}
              class="inline-flex h-10 items-center rounded-full px-3 transition-expressive hover:bg-surface-container-high hover:text-on-surface"
            >
              {label}
            </a>
          ) : (
            <span aria-current="page" class="inline-flex h-10 items-center px-3 text-on-surface">
              {label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
