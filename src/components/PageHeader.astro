---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="pt-8 pb-10 sm:pt-16 sm:pb-16">
  <h1 class="max-w-4xl font-display text-hero text-balance">
    {title}
  </h1>
  {
    lede && (
      <p class="mt-5 max-w-2xl text-title-lg font-normal text-pretty text-on-surface-variant sm:mt-6">
        {lede}
      </p>
    )
  }
  <slot />
</header>
