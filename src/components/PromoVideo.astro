---
import Icon from './Icon.astro';

interface Props {
  /** YouTube video ID. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<!--
  A click-to-load YouTube embed. Nothing from YouTube loads until the viewer
  presses play, which keeps the page fast and sets no third-party cookies
  (the player uses youtube-nocookie.com).
-->
<div
  data-video={id}
  data-title={title}
  class="relative aspect-video w-full overflow-hidden rounded-xl bg-surface-container-highest sm:rounded-xl-inc"
>
  <button
    type="button"
    data-video-play
    aria-label={`Play video: ${title}`}
    class="group absolute inset-0 block size-full cursor-pointer"
  >
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      loading="lazy"
      decoding="async"
      class="size-full object-cover"
    />
    <span class="absolute inset-0 grid place-items-center bg-black/20 transition-colors group-hover:bg-black/10">
      <span
        class="grid size-16 place-items-center rounded-full bg-primary text-on-primary shadow-lg transition-transform group-hover:scale-105 group-active:scale-95 sm:size-20"
      >
        <Icon name="play_arrow" class="text-[2.25rem] sm:text-[2.75rem]" />
      </span>
    </span>
  </button>
  <noscript>
    <a href={`https://www.youtube.com/watch?v=${id}`} class="text-link absolute inset-0 grid place-items-center">
      Watch on YouTube
    </a>
  </noscript>
</div>

<script>
  function load(root: HTMLElement) {
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${root.dataset.video}?autoplay=1&rel=0`;
    iframe.title = root.dataset.title ?? 'Video';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.className = 'absolute inset-0 size-full border-0';
    root.replaceChildren(iframe);
  }
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    root.querySelector('[data-video-play]')?.addEventListener('click', () => load(root));
  });
</script>
